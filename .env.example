# Demo mode runs locally without credentials. Never enable it in production.
DEMO_MODE=true
PORT=3000
# Live mode: set DEMO_MODE=false and supply server-side settings.
DATATAP_BASE_URL=https://develop-api.esper.cloud/api/data-tap/v0
DATATAP_API_KEY=
SESSION_SECRET=
# JSON array: each user has id, name, email, passwordHash (scrypt:salt:hash), tenant, role.
REPORTING_USERS=[]

# For multi-tenant live instances, credentials are explicitly mapped per tenant.
# DATATAP_TENANTS={"tenant-a":{"baseUrl":"https://your-api/api/data-tap/v0","apiKey":"..."}}
# DATA_DIR=.data
